# ns74.env — copy to ns74.env, edit, never commit. Sourced by ns74ctl.

# === DECENTRALIZED FLEET IDENTITY (no shared seed) ===
# Each of the ~21 core-nodes has its OWN key. They are bound to the fleet by an
# on-chain chain: node record -> master-user -> org owner address.
#
# Find these with:  ns74ctl node discover   (queries your emercoind)
NS74_MASTER_USER=ness                 # the org master-user nodes chain to
NS74_ORG_ADDRESS=                     # EMC address that owns the org NVS records (trust root)
NS74_NODE_URL=https://node1.ns74.com  # THIS node's URL (its identity)
# NS74_FORCE_BUILTIN=1                 # force built-in keygen even if PrivatenessTools present

# --- settlement / NVS ---
NS74_PAY_TO=YOUR_OPERATOR_NESS_ADDRESS
EMC_RPC=http://127.0.0.1:6662
NS74_EMC_USER=
NS74_EMC_PASS=

# --- DNSCrypt stamp / DoH ---
EXTERNAL_IP=154.16.118.97
DOMAIN=ns74.com

# --- gate (local single-operator key still derives from ~/.privateness-keys/master.seed) ---
GATE_ADDR=127.0.0.1:8402
GATE_DEV=0

# The local master.seed is used ONLY for this operator's gate key derivation,
# NOT for fleet identity. It is never shared between nodes.
